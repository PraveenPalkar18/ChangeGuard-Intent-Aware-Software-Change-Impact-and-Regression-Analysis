# ==============================================================================
# ChangeGuard Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME=ChangeGuard
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# GitHub API Credentials
# A personal access token (classic or fine-grained with read-only access to PRs and repo content)
# Without a token, GitHub REST API is strictly limited to 60 requests/hour per IP.
GITHUB_TOKEN=your_github_personal_access_token_here

# AI / Model Configuration
# Supported providers: 'groq' (Groq Cloud Free Tier), 'gemini' (Google Gemini API), 'tfidf' (local deterministic baseline), 'llm' (OpenAI-compatible)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_from_console_groq_com
AI_MODEL_NAME=qwen/qwen3.8-27b
# Alternative verified Groq models: openai/gpt-oss-120b, openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
AI_FALLBACK_ENABLED=true
AI_CACHE_ENABLED=true


# Automatic Monitoring Configuration (Milestone 8)
MONITORING_ENABLED_BY_DEFAULT=false
MONITORING_POLL_INTERVAL_SECONDS=60
MONITORING_STATE_FILE=data/monitoring_state.json
MONITORED_REPOSITORIES=
MAX_PROCESSING_RETRIES=3

# GitHub Reporting Configuration (Milestone 9)
ENABLE_GITHUB_REPORTING=false

