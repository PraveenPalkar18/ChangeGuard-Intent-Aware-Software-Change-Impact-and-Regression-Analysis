# ==============================================================================
# ChangeGuard Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME=ChangeGuard
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# GitHub API Credentials
# A personal access token (classic or fine-grained with read-only access to PRs and repo content)
# Without a token, GitHub REST API is strictly limited to 60 requests/hour per IP.
GITHUB_TOKEN=your_github_personal_access_token_here

# AI / Model Configuration
AI_PROVIDER=tfidf
AI_MODEL=tfidf-word-v1
AI_API_KEY=

# Automatic Monitoring Configuration (Milestone 8)
MONITORING_ENABLED_BY_DEFAULT=false
MONITORING_POLL_INTERVAL_SECONDS=60
MONITORING_STATE_FILE=data/monitoring_state.json
MONITORED_REPOSITORIES=
MAX_PROCESSING_RETRIES=3

# GitHub Reporting Configuration (Milestone 9)
ENABLE_GITHUB_REPORTING=false

